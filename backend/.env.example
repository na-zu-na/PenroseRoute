APP_NAME=PenroseRoute API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/penrose_route
AT_RISK_THRESHOLD_SECONDS=900

# template runs without AWS credentials; bedrock only arranges verified facts.
AGENT_EXPLANATION_PROVIDER=template
# BEDROCK_MODEL_ID=your-supported-model-or-inference-profile-id
AWS_REGION=ap-southeast-1
# Optional Bedrock-compatible endpoint (not an OpenAI chat-completions URL).
# BEDROCK_ENDPOINT_URL=https://your-bedrock-endpoint
AGENT_CONNECT_TIMEOUT_SECONDS=3
AGENT_READ_TIMEOUT_SECONDS=10
# Authentication: AWS credential chain or export AWS_BEARER_TOKEN_BEDROCK
# into the process environment. Never commit credentials to this file.

# Dispatch entry point. No default credentials; generate random values locally.
DISPATCH_INTENT_PROVIDER=rules
BUSINESS_TIMEZONE=Asia/Singapore
# DISPATCH_CONTEXT_SECRET=<random-string-at-least-32-characters>
# DISPATCH_API_TOKENS='{"<random-bearer-token-at-least-32-characters>":{"subject":"dispatcher-1","role":"dispatcher"}}'
# Use role "reader" for read-only accounts. This is a single-workspace API-key setup.
