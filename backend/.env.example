APP_NAME=PenroseRoute API
APP_ENV=development
# Optional local demo only: pin dispatcher decision time to the simulated
# operating window. Ignored unless APP_ENV=development. Remove after the demo.
# DEMO_DECISION_NOW=2026-09-28T17:56:00+08:00
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/penrose_route
AT_RISK_THRESHOLD_SECONDS=900
ALERT_SCAN_INTERVAL_SECONDS=30

# Set to osrm for road-network planning and route geometry.
# Run a controlled OSRM driving service before enabling this mode.
ROUTING_PROVIDER=deterministic
OSRM_BASE_URL=http://localhost:5000
OSRM_TIMEOUT_SECONDS=8

# Add your private ARK_API_KEY only to backend/.env (never commit it).
# The Ark model is used only for intent selection and verified-fact explanation.
# Keep deterministic for existing P0 regression; set agent for formal Recovery Agent runtime.
RECOVERY_ORCHESTRATION_MODE=deterministic
AGENT_EXPLANATION_PROVIDER=ark
ARK_MODEL_ID=deepseek-v4-flash-ga-260731
ARK_TIMEOUT_SECONDS=1800
# ARK_API_KEY=your-private-ark-api-key
# Without ARK_API_KEY, dispatch uses rules and explanations use templates.
# Optional legacy provider: AGENT_EXPLANATION_PROVIDER=bedrock
# BEDROCK_MODEL_ID=your-supported-model-or-inference-profile-id
AWS_REGION=ap-southeast-1
# Optional Bedrock-compatible endpoint (not an OpenAI chat-completions URL).
# BEDROCK_ENDPOINT_URL=https://your-bedrock-endpoint
AGENT_CONNECT_TIMEOUT_SECONDS=3
AGENT_READ_TIMEOUT_SECONDS=10
# Authentication: AWS credential chain or export AWS_BEARER_TOKEN_BEDROCK
# into the process environment. Never commit credentials to this file.

# Dispatch entry point. No default credentials; generate random values locally.
DISPATCH_INTENT_PROVIDER=ark
# Optional rule-only mode: DISPATCH_INTENT_PROVIDER=rules
BUSINESS_TIMEZONE=Asia/Singapore
# DISPATCH_CONTEXT_SECRET=<random-string-at-least-32-characters>
# DISPATCH_API_TOKENS='{"<random-bearer-token-at-least-32-characters>":{"subject":"dispatcher-1","role":"dispatcher"}}'
# Use role "reader" for read-only accounts. This is a single-workspace API-key setup.
